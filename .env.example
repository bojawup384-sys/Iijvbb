# ───────── Required ─────────
# PostgreSQL connection string (Neon / Supabase / Vercel Postgres). POSTGRES_URL also works.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Google AI Studio key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# ───────── Recommended ─────────
# Your public domain (used for sitemap / canonical / social previews)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Secret (12+ chars) for the admin endpoint that creates promo codes
ADMIN_SECRET=

# ───────── Payments (optional) ─────────
CHARGILY_SECRET_KEY=
CHARGILY_MODE=live

# ───────── Firebase (optional overrides — defaults are built in) ─────────
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=

# ───────── AI team (Pro "dream team": ALL engines work together) ─────────
# Add as many as you have — each engine that has a key joins the team automatically.
# Every engine drafts in parallel, then the lead engine merges everything into one
# stronger result (and automatically takes over from the next engine if it is down).
ANTHROPIC_API_KEY=          # Claude   (console.anthropic.com) — CLAUDE_API_KEY also works
DEEPSEEK_API_KEY=           # DeepSeek (platform.deepseek.com)
XAI_API_KEY=                # Grok     (console.x.ai) — GROK_API_KEY also works
OPENROUTER_API_KEY=
GROQ_API_KEY=
# Who merges the drafts first: claude (default) | gemini | grok | deepseek | openrouter | groq
# BARQ_LEAD=claude
# Max wait for the drafting stage in ms (default 55000)
# BARQ_DRAFT_MS=55000
# Optional model overrides
# ANTHROPIC_MODEL=
# DEEPSEEK_MODEL=
# XAI_MODEL=
# OPENROUTER_MODEL=
# GROQ_MODEL=
